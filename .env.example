# Admin API key cua OpenAI (KHAC voi API key project dung de goi chat/completions).
# Tao o: https://platform.openai.com/settings/organization/admin-keys
# Key nay co quyen doc Usage/Costs API cua CA to chuc (moi project, moi nguon),
# tuyet doi khong dung lam key goi completions va khong commit gia tri that vao git.
OPENAI_ADMIN_API_KEY=

# Cong chay server local.
PORT=4600

# De xem chi tiet API key "chatbotgpt" dung o tung tinh nang (khau) nao ben
# trong web_chat_bot - URL goc cua chatbotgpt (vd http://112.213.91.235:8000)
# va secret khop voi AI_USAGE_DASHBOARD_SECRET trong .env cua chatbotgpt tren
# VPS. De trong se bo qua phan nay, khong loi.
CHATBOTGPT_USAGE_URL=
CHATBOTGPT_USAGE_SECRET=
